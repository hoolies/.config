# Condig
conky.config = {

--  Window Settings

    out_to_x = false,
    out_to_wayland = true,

    own_window = true,
    -- override is a bottom layer-shell surface: on the wallpaper, under windows,
    -- and not an application on each virtual desktop. normal is an xdg toplevel.
    own_window_type = 'override',
    own_window_hints = 'undecorated,below,skip_taskbar,skip_pager',
    -- AARRGGBB. Fully clear, so the wallpaper shows through the gaps.
    own_window_colour = '#00000000',
    own_window_class = 'Conky',
    lua_load = '/home/hoolies/Projects/Bourne_Again/git_config/conky/battery_bolt.lua',
    lua_draw_hook_post = 'battery_bolt',
    minimum_width = 340, minimum_height = 140,-- width | height
    alignment = 'bottom_left',
    gap_x = 60,-- left | right
    gap_y = 50,-- up | down

--  Font Settings
-- Use Xft (anti-aliased font and stuff)
    use_xft = true,

--font = 'Liberation Mono:bold:size=10',
--font = 'Liberation Sans:size=10',
    -- Grayscale antialiasing, so glyph edges stay a single color.
    font = 'Hack Nerd Font Mono:size=14:rgba=none',

-- Alpha of Xft font. Must be a value at or between 1 and 0
    xftalpha = 1,

-- Force UTF8? requires XFT
    override_utf8_locale = true,

    uppercase = false,
--  End Font Settings


--  Color Settings
    draw_shades = false,
    default_shade_color = '000000',

    draw_outline = false,-- amplifies text if true
    default_outline_color = '000000',

    default_color = '46d2ff', -- labels
    color0 = '7fffff',        -- clock and headings
    color1 = '4dff88',        -- live values
    color2 = 'ffb01a',        -- throughput and memory

--  End Color Settings


--  Borders Section
    draw_borders = false,
-- Stippled borders?
    stippled_borders = 5,
-- border margins
    border_inner_margin = 5,
    border_outer_margin = 0,
-- border width
    border_width = 2,
-- graph borders
    draw_graph_borders = false,
--default_graph_height = 15,
--default_graph_width = 40,
--  End Borders Section


--  Miscellaneous Section
-- Boolean value, if true, Conky will be forked to background when started.
    background = true,


-- Adds spaces around certain objects to stop them from moving other things
-- around, this only helps if you are using a mono font
-- Options: right, left or none
    use_spacer = 'none',

-- Default and Minimum size is 256 - needs more for single commands that
-- "call" a lot of text IE: bash scripts
--text_buffer_size = 6144,

-- Subtract (file system) buffers from used memory?
    no_buffers = true,

-- change GiB to G and MiB to M
    short_units = true,

-- Imlib2 image cache size, in bytes. Default 4MiB Increase this value if you use
-- $image lots. Set to 0 to disable the image cache.
    imlib_cache_size = 0,

-- Use the Xdbe extension? (eliminates flicker)
-- It is highly recommended to use own window with this one
-- so double buffer won't be so big.
    double_buffer = true,

-- Maximum size of user text buffer, i.e. layout below TEXT line in config file
-- (default is 16384 bytes)
--max_user_text = 16384,

-- Desired output unit of all objects displaying a temperature. Parameters are
-- either "fahrenheit" or "celsius". The default unit is degree Celsius.
--temperature_unit = 'Fahrenheit',

-- Update interval in seconds
    update_interval = 1,

--  End Miscellaneous Section
};

-- Commands that are not used
-- ${execi 1 ping -c1 8.8.8.8 | sed -n 's/.*time=\(.*\) /\1/p'}  ${execi 1 dgw}


---------------------------------------------------
---------------------------------------------------

conky.text = [[
# Uptime
${font Monospace:size=14:rgba=none}${offset 1400}$alignc${color}Uptime:  ${color1} $uptime
# Kernel version
${color}${offset 1400}Kernel:   ${color1}${exec uname -r}
# Battery
${offset 1400}${color}Battery:  ${color0}${battery_percent BAT0}%  ${color0}${battery_bar 11,75 BAT0}

# CPU. Each row is one core's two threads. Odd cores left, even cores right.
${offset 1400}${color}CPU ${cpugraph 11,70 FF0000 FFFF00 s}  ${color0}${lua cpup 0}${goto 1610}${freq 1} Mhz
${offset 1400}${color}C1${goto 1435}${cpugraph cpu1 11,22 FF0000 FFFF00}${goto 1463}${color1}${lua cpup 1}${goto 1513}${cpugraph cpu5 11,22 FF0000 FFFF00}${goto 1541}${color1}${lua cpup 5}${goto 1610}${color}C2${goto 1638}${cpugraph cpu2 11,22 FF0000 FFFF00}${goto 1666}${color1}${lua cpup 2}${goto 1736}${cpugraph cpu6 11,22 FF0000 FFFF00}${goto 1764}${color1}${lua cpup 6}
${offset 1400}${color}C3${goto 1435}${cpugraph cpu3 11,22 FF0000 FFFF00}${goto 1463}${color1}${lua cpup 3}${goto 1513}${cpugraph cpu7 11,22 FF0000 FFFF00}${goto 1541}${color1}${lua cpup 7}${goto 1610}${color}C4${goto 1638}${cpugraph cpu4 11,22 FF0000 FFFF00}${goto 1666}${color1}${lua cpup 4}${goto 1736}${cpugraph cpu8 11,22 FF0000 FFFF00}${goto 1764}${color1}${lua cpup 8}
${offset 1400}${color0}Network:
# Wireless
${if_existing /proc/net/route wlp5s0}${offset 1500}${color} SSID:     ${color0}${exec 'nmcli connection show --active | grep -i wifi | cut -d" " -f1'}
${offset 1500}${color} Local:    ${color1}${addr wlp5s0}
${offset 1500}${color} Public:   ${color1}${exec curl ifconfig.me}
${offset 1500}${color} Quality:  ${color1}${exec 'LC_ALL=C.UTF-8 nmcli -t -f IN-USE,BARS dev wifi list --rescan no | grep "^\*" | cut -d: -f2'} ${endif}

#  network inbound and outbound. Up on the left, Down on the right.
${offset 1500} ${color0}↑${goto 1660}↓
${offset 1500} ${color2}${upspeed wlp5s0}${goto 1660}${downspeed wlp5s0}
${offset 1500} ${upspeedgraph wlp5s0 25,120 5dffe0 ff9f1a -x}${goto 1660}${downspeedgraph wlp5s0 25,120 5dffe0 ff9f1a -x}

# Memory
${color0}
${offset 1400}Memory:
${offset 1500}  ${color}Used:  ${color2}${mem}
${offset 1500}  ${color}Free:  ${color2}${memfree}
${offset 1500}  ${color}Avail: ${color2}${memeasyfree}

# Processes
${offset 1400}${color0}Name               PID   CPU%    MEM%${color}
${offset 1400}${top name 1}${color1}${top pid 1} ${top cpu 1} ${top mem 1}${color}
${offset 1400}${top name 2}${color1}${top pid 2} ${top cpu 2} ${top mem 2}${color}
${offset 1400}${top name 3}${color1}${top pid 3} ${top cpu 3} ${top mem 3}${color}
${offset 1400}${top name 4}${color1}${top pid 4} ${top cpu 4} ${top mem 4}

${offset 1400}${color0}Processes: ${color1}$processes  ${color}Running: ${color1}$running_processes${color}

${font Monospace:size=84:rgba=none}${color0}${time %H:%M}${font}

${font Monospace:size=22:rgba=none}${time %A %d %B}${font}
]]
